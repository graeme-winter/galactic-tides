ics = galaxy_ics.hdf5
output_dir = galaxy
snapshot_prefix = snap

eps = 0.05
theta = 0.6
quadrupole = true
leaf_size = 8

dt = 0.01             # ~130 kyr for the Milky Way scaling
t_end = 100.0         # ~1.3 Gyr
snapshot_interval = 1.0
log_interval = 50

# Force calculation: gravity = tree | group | direct, device = cpu | metal.
# tree is the per-particle walk on the CPU; group is the grouped walk whose
# interaction lists run on either (use it with device = metal for the GPU);
# direct is O(N^2) (double on the CPU, single precision on the GPU).
gravity = tree
device = cpu
# group_size = 32
# metal_simds = 4    # GPU tree: groups per threadgroup (0: tiled kernel)
